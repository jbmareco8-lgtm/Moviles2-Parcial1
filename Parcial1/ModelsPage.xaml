<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Parcial1.ModelsPage"
    Title="Detalle de marca">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="6">

            <Label
                Text="Detalle de la marca"
                FontSize="14" />

            <Label
                Text="{Binding MakeName,
                               StringFormat='Marca: {0}'}"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="{Binding VehicleTypeName,
                               StringFormat='Tipo de vehículo: {0}'}"
                FontSize="15" />

            <Label
                Text="{Binding MakeId,
                               StringFormat='ID de marca: {0}'}"
                FontSize="14" />

        </VerticalStackLayout>

        <Label
            Grid.Row="1"
            Text="Modelos disponibles"
            FontSize="20"
            FontAttributes="Bold" />

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="5">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding StatusMessage}"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Models}">

            <CollectionView.EmptyView>

                <Label
                    Text="No hay modelos para mostrar."
                    HorizontalTextAlignment="Center"
                    Margin="0,20" />

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame
                        Padding="15"
                        Margin="0,5"
                        HasShadow="True">

                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="{Binding ModelName}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding MakeName}"
                                FontSize="13" />

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>