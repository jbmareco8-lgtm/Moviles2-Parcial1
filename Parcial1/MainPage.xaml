<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Parcial1.ViewModels"
    xmlns:models="clr-namespace:Parcial1.Models"
    x:Class="Parcial1.MainPage"
    x:Name="MainPageRoot"
    x:DataType="vm:MainViewModel"
    Title="Marcas de autos">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="15">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="Marcas de autos"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Consulta de marcas mediante una API REST"
                FontSize="14" />

        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Cargar marcas"
            Command="{Binding LoadCarMakesCommand}" />

        <SearchBar
            Grid.Row="2"
            Placeholder="Buscar marca..."
            Text="{Binding SearchText}" />

        <VerticalStackLayout
            Grid.Row="3"
            Spacing="5">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding StatusMessage}"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <RefreshView
            Grid.Row="4"
            Command="{Binding LoadCarMakesCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">

            <CollectionView
                ItemsSource="{Binding CarMakes}">

                <CollectionView.EmptyView>

                    <Label
                        Text="No hay marcas para mostrar."
                        HorizontalTextAlignment="Center"
                        Margin="0,20" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:CarMake">

                        <Frame
                            Padding="15"
                            Margin="0,5"
                            HasShadow="True">

                            <Frame.GestureRecognizers>

                                <TapGestureRecognizer
                                    x:DataType="{x:Null}"
                                    Command="{Binding Source={x:Reference MainPageRoot},
                                                      Path=BindingContext.SelectMakeCommand}"
                                    CommandParameter="{Binding .}" />

                            </Frame.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="4">

                                <Label
                                    Text="{Binding MakeName}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding VehicleTypeName}"
                                    FontSize="13" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>