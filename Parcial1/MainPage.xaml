<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Parcial1.MainPage"
    Title="Marcas de autos">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <VerticalStackLayout Grid.Row="0" Spacing="5">

            <Label
                Text="Marcas de autos"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Consulta de marcas mediante una API REST"
                FontSize="14" />

        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Cargar marcas"
            Command="{Binding LoadCarMakesCommand}" />

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="5">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding StatusMessage}"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding CarMakes}">

            <CollectionView.EmptyView>

                <Label
                    Text="Todavía no hay marcas cargadas."
                    HorizontalTextAlignment="Center"
                    Margin="0,20" />

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame
                        Padding="15"
                        Margin="0,5"
                        HasShadow="True">

                        <VerticalStackLayout>

                            <Label
                                Text="{Binding MakeName}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding VehicleTypeName}"
                                FontSize="13" />

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>