<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Parcial1.ViewModels"
    xmlns:models="clr-namespace:Parcial1.Core.Models;assembly=Parcial1.Core"
    x:Class="Parcial1.FavoritesPage"
    x:Name="FavoritesPageRoot"
    x:DataType="vm:FavoritesViewModel"
    Title="Mis favoritos">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="Mis favoritos"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Marcas guardadas en tu dispositivo"
                FontSize="14" />

        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Actualizar favoritos"
            Command="{Binding LoadFavoritesCommand}" />

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="5">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding StatusMessage}"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Favorites}">

            <CollectionView.EmptyView>

                <Label
                    Text="No hay favoritos guardados."
                    HorizontalTextAlignment="Center"
                    Margin="0,20" />

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:FavoriteMake">

                    <Border
                        Padding="15"
                        Margin="0,5"
                        StrokeThickness="1"
                        Stroke="Gray"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding MakeName}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding VehicleTypeName}"
                                FontSize="14" />

                            <Label
                                Text="{Binding AddedAt,
                                    StringFormat='Guardada el {0:dd/MM/yyyy}'}"
                                FontSize="12" />

                            <Label
                                Text="{Binding LocationText}"
                                FontSize="13" />

                            <Button
                                Text="Guardar ubicacion"
                                Command="{Binding
                                    Source={x:Reference FavoritesPageRoot},
                                    Path=BindingContext.SaveLocationCommand,
                                    x:DataType={x:Null}}"
                                CommandParameter="{Binding .}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    Grid.Column="0"
                                    Text="Ver modelos"
                                    Command="{Binding
                                        Source={x:Reference FavoritesPageRoot},
                                        Path=BindingContext.SelectFavoriteCommand,
                                        x:DataType={x:Null}}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Grid.Column="1"
                                    Text="Eliminar"
                                    BackgroundColor="#B91C1C"
                                    TextColor="White"
                                    Command="{Binding
                                        Source={x:Reference FavoritesPageRoot},
                                        Path=BindingContext.DeleteFavoriteCommand,
                                        x:DataType={x:Null}}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>